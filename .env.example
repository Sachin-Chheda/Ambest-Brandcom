# The private review build stays noindex unless explicitly enabled for an approved production release.
PUBLIC_SITE=false

# Cloudflare Turnstile widget and server verification keys.
TURNSTILE_SITE_KEY=replace_with_approved_site_key
TURNSTILE_SECRET_KEY=replace_with_server_secret

# HTTPS endpoint that durably accepts the sanitized lead record.
LEAD_WEBHOOK_URL=https://example.invalid/ambest-leads
LEAD_WEBHOOK_TOKEN=replace_with_server_secret

# Local automated tests only. Never enable in production.
DEVELOPMENT_MODE=false
