{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ambest-brandcom",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.ambestbrandcom.com/*",
      "zone_name": "ambestbrandcom.com"
    },
    {
      "pattern": "ambestbrandcom.com/*",
      "zone_name": "ambestbrandcom.com"
    }
  ],
  "vars": {
    "PUBLIC_SITE": "true"
  },
  "observability": {
    "enabled": true
  }
}
