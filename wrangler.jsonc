{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ambest-brandcom",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.ambestbrandcom.com/*",
      "zone_name": "ambestbrandcom.com"
    },
    {
      "pattern": "ambestbrandcom.com/*",
      "zone_name": "ambestbrandcom.com"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "sachin@ambestmedia.com"
    }
  ],
  "vars": {
    "PUBLIC_SITE": "true",
    "LEAD_RECIPIENT": "sachin@ambestmedia.com",
    "LEAD_SENDER": "website@ambestbrandcom.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFIsr9Ejvj4ShRSb"
  },
  "observability": {
    "enabled": true
  }
}

